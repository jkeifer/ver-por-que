{
    "name": "ver-por-que",
    "version": "1.0.0",
    "type": "module",
    "description": "An interactive web-based tool for exploring how parquet files are structured. Pair with the python tool por-que, dump the file structure to JSON, and then load in this UI to see how the file is put together.",
    "scripts": {
        "prepare": "prek install -f",
        "generate": "node scripts/generate.mjs",
        "wheel": "python3 scripts/fetch-wheels.py",
        "predev": "npm run generate",
        "dev": "vite",
        "prebuild": "npm run generate && node scripts/get-git-info.js",
        "build": "vite build",
        "preview": "vite preview",
        "pretest": "npm run generate",
        "test": "vitest run",
        "e2e": "playwright test",
        "pretypecheck": "npm run generate",
        "typecheck": "tsc --noEmit",
        "prelint": "npm run generate",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "format": "prettier --write src/ test/ e2e/ index.html vite.config.ts playwright.config.ts",
        "format:check": "prettier --check src/ test/ e2e/ index.html vite.config.ts playwright.config.ts"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/jkeifer/ver-por-que.git"
    },
    "keywords": [],
    "author": "",
    "license": "Apache-2.0",
    "bugs": {
        "url": "https://github.com/jkeifer/ver-por-que/issues"
    },
    "homepage": "https://teotl.dev/ver-por-que",
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@j178/prek": "^0.4.8",
        "@playwright/test": "^1.61.1",
        "@types/node": "^26.1.0",
        "ajv": "^8.20.0",
        "eslint": "^10.6.0",
        "globals": "^17.7.0",
        "json-schema-to-typescript": "^15.0.4",
        "prettier": "^3.6.2",
        "pyodide": "^314.0.2",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.8.0",
        "vite": "^8.1.3",
        "vitest": "^4.1.9"
    }
}
